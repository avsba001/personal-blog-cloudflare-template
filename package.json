{
  "name": "blog-system-v1",
  "version": "1.0.0",
  "description": "Modern personal blog system on Cloudflare Workers",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:backend": "wrangler dev",
    "build": "npm run build --workspace=frontend",
    "deploy": "npm run typecheck --workspace=backend && npm run db:migrate:remote && wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "init": "bash scripts/init.sh",
    "migrate": "bash scripts/migrate.sh",
    "test": "npm run test --workspaces --if-present"
  },
  "cloudflare": {
    "bindings": {
      "JWT_SECRET": {
        "description": "必填：填写至少 32 字符的随机密钥。可用 `openssl rand -hex 32` 生成；不要使用示例值或提交到 Git。"
      }
    }
  },
  "keywords": ["blog", "cloudflare", "workers", "d1"],
  "author": "",
  "license": "MIT"
}
